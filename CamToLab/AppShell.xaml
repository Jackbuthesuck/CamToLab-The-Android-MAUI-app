<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiJohnWick1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiJohnWick1"
    Title="MauiJohnWick1">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,24,20,12" Spacing="12">
            <Label Text="Display" FontAttributes="Bold" FontSize="18" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <Label Text="Show LAB values (Off for RGB)" VerticalTextAlignment="Center" />
                <Switch x:Name="DisplayLabSwitch" Grid.Column="1" Toggled="OnDisplayLabToggled" />
            </Grid>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <MenuItem Text="Pick Image" Clicked="OnPickImageClicked" />
    <MenuItem Text="Load Test Card" Clicked="OnLoadTestCardClicked" />

</Shell>
